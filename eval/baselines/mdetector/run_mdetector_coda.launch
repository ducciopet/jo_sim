<launch>
  <!-- upstream detector_nuscenes.launch with the JO parameter file, no rviz -->
  <param name="use_sim_time" value="true"/>
  <arg name="cfg" default="coda.yaml"/>
  <rosparam command="load" file="/jo/$(arg cfg)" />
  <node pkg="m_detector" type="dynfilter" name="dynfilter" output="screen" />
</launch>
