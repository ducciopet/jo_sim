<launch>
  <!-- upstream run_detector.launch with the JO parameter file and without rviz (headless replay) -->
  <param name="use_sim_time" value="true"/>
  <rosparam file="/jo/detector_param_jo.yaml" ns="/onboard_detector" />
  <node pkg="onboard_detector" type="detector_node" name="detector_node" output="screen" />
  <node pkg="onboard_detector" type="yolov11_detector_node.py" name="yolov11_detector_node" output="log">
    <remap from="/camera/color/image_raw" to="/front_camera/camera/color/image_raw"/>
  </node>
</launch>
