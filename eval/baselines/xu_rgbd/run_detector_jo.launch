<launch>
  <!-- upstream run_detector.launch (no learning module) with the JO parameter file and without rviz -->
  <param name="use_sim_time" value="true"/>
  <rosparam file="/jo/detector_param_jo.yaml" ns="/onboard_detector" />
  <node pkg="onboard_detector" type="detector_node" name="detector_node" output="screen" />
</launch>
